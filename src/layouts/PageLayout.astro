---
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description: string;
	mainClass?: string;
	noindex?: boolean;
}

const { title, description, mainClass, noindex = false } = Astro.props;
---

<BaseLayout
	{title}
	{description}
	{noindex}
	mainClass={['prose', mainClass].filter(Boolean).join(' ')}
>
	<h1>{title}</h1>
	<slot />
</BaseLayout>
