---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { BASE_URL } from '../consts';
import FormattedDate from '../components/FormattedDate.astro';
import Tags from '../components/Tags.astro';
import BaseLayout from './BaseLayout.astro';

type PostData = CollectionEntry<'blog'>['data'];

interface LinkedPost {
	id: string;
	title: string;
}

interface Props extends PostData {
	newer?: LinkedPost | null;
	older?: LinkedPost | null;
	headings?: Array<{ depth: number; slug: string; text: string }>;
	minutes?: number;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	alt,
	tags,
	newer,
	older,
	headings = [],
	minutes,
} = Astro.props;

const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout
	{title}
	{description}
	image={heroImage}
	imageAlt={alt}
	type="article"
	publishedTime={pubDate}
	modifiedTime={updatedDate}
	{tags}
	{minutes}
>
	{heroImage && (
		<div class="hero-image">
			<Image
				width={1020}
				height={510}
				layout="constrained"
				widths={[480, 720, 1020]}
				priority
				src={heroImage}
				alt={alt ?? ''}
			/>
		</div>
	)}
	<article>
		<div class="prose">
			<header class="title">
				<div class="date">
					<FormattedDate date={pubDate} />
					{minutes && <> · {minutes} min de lectura</>}
					{updatedDate && (
						<div class="last-updated-on">
							Última actualización: <FormattedDate date={updatedDate} />
						</div>
					)}
				</div>
				<h1>{title}</h1>
				<div class="tags-header"><Tags {tags} linked /></div>
				<hr />
			</header>

			{toc.length > 1 && (
				<nav class="toc" aria-labelledby="toc-title">
					<h2 id="toc-title">En este artículo</h2>
					<ol>
						{toc.map((heading) => (
							<li class:list={[`depth-${heading.depth}`]}>
								<a href={`#${heading.slug}`}>{heading.text}</a>
							</li>
						))}
					</ol>
				</nav>
			)}

			<slot />

			{(newer || older) && (
				<nav class="post-nav" aria-label="Navegación entre artículos">
					{newer ? (
						<a class="prev" href={`${BASE_URL}blog/${newer.id}/`}>
							<span class="label">← Más reciente</span>
							{newer.title}
						</a>
					) : (
						<span></span>
					)}
					{older && (
						<a class="next" href={`${BASE_URL}blog/${older.id}/`}>
							<span class="label">Más antiguo →</span>
							{older.title}
						</a>
					)}
				</nav>
			)}
		</div>
	</article>
</BaseLayout>

<style>
	.hero-image {
		width: 100%;
		max-width: 1020px;
		margin: 0 auto;
	}
	.hero-image img {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
		margin: 0;
		border-radius: 0;
	}
	.prose {
		width: 100%;
		margin: 0;
		padding: 0;
		color: rgb(var(--gray-dark));
	}
	.title {
		margin-bottom: 1em;
		padding: 1em 0;
		text-align: center;
		line-height: 1;
	}
	.title h1 {
		margin: 0 0 0.5em 0;
	}
	.tags-header {
		display: flex;
		justify-content: center;
	}
	.date {
		margin-bottom: 0.5em;
		color: rgb(var(--gray));
	}
	.last-updated-on {
		font-style: italic;
	}
	.toc {
		margin: 0 0 2em;
		padding: 1rem 1.25rem;
		background: rgba(96, 165, 250, 0.08);
		border: 1px solid var(--border);
		border-radius: 14px;
		font-size: 0.95em;
	}
	.toc h2 {
		margin: 0 0 0.5em;
		font-size: 1.1rem;
	}
	.toc ol {
		margin: 0;
		padding-left: 1.2em;
	}
	.toc li {
		margin: 0.25em 0;
	}
	.toc a {
		text-decoration: none;
	}
	.toc a:hover,
	.toc a:focus-visible {
		text-decoration: underline;
	}
	.depth-3 {
		margin-left: 1rem;
	}
	.post-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: space-between;
		margin-top: 3em;
		padding-top: 1.5em;
		border-top: 1px solid var(--border);
	}
	.post-nav a {
		max-width: 48%;
		text-decoration: none;
	}
	.post-nav a:hover {
		text-decoration: underline;
	}
	.post-nav .label {
		display: block;
		color: rgb(var(--gray));
		font-size: 0.8rem;
	}
	.post-nav .next {
		margin-left: auto;
		text-align: right;
	}
</style>
