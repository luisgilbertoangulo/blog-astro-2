---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SkipLink from '../components/SkipLink.astro';
import type { BreadcrumbItem } from '../utils/jsonld';

interface Props {
	title: string;
	description: string;
	mainClass?: string;
	noindex?: boolean;
	type?: 'website' | 'article';
	image?: ImageMetadata;
	imageAlt?: string;
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
	minutes?: number;
	breadcrumbs?: BreadcrumbItem[];
	profile?: boolean;
}

const {
	title,
	description,
	mainClass,
	noindex = false,
	type = 'website',
	image,
	imageAlt,
	publishedTime,
	modifiedTime,
	tags,
	minutes,
	breadcrumbs,
	profile,
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			{title}
			{description}
			{noindex}
			{type}
			{image}
			{imageAlt}
			{publishedTime}
			{modifiedTime}
			{tags}
			{minutes}
			{breadcrumbs}
			{profile}
		/>
	</head>
	<body>
		<SkipLink />
		<Header />
		<main id="main" class:list={[mainClass]}>
			<slot />
		</main>
		<Footer />
	</body>
</html>
