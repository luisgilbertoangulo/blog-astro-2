---
import type { CollectionEntry } from 'astro:content';
import PostList from '../../../components/PostList.astro';
import Tags from '../../../components/Tags.astro';
import { BASE_URL } from '../../../consts';
import type { BreadcrumbItem } from '../../../utils/jsonld';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllTags, getSortedPosts } from '../../../utils/posts';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	const tags = getAllTags(posts);
	return tags.map((tag) => ({
		params: { tag },
		props: {
			tag,
			allTags: tags,
			posts: posts.filter((post) => post.data.tags.includes(tag)),
		},
	}));
}

interface Props {
	tag: string;
	allTags: string[];
	posts: CollectionEntry<'blog'>[];
}

const { tag, allTags, posts } = Astro.props;
const breadcrumbs: BreadcrumbItem[] = [
	{ name: 'Inicio', url: BASE_URL },
	{ name: 'Artículos', url: `${BASE_URL}blog/` },
	{ name: tag },
];
---

<BaseLayout
	title={`Artículos sobre ${tag}`}
	description={`Apuntes del blog etiquetados como ${tag}.`}
	mainClass="wide prose"
	{breadcrumbs}
>
	<header class="tag-header">
		<p class="eyebrow">Explora por etiqueta</p>
		<h1>Artículos sobre <span>{tag}</span></h1>
		<p class="count">{posts.length} {posts.length === 1 ? 'artículo' : 'artículos'} publicados.</p>
	</header>

	<nav class="all-tags" aria-label="Todas las etiquetas">
		<h2>Otras etiquetas</h2>
		<Tags tags={allTags} linked active={tag} />
	</nav>

	<section>
		<PostList {posts} />
	</section>

	<p class="back"><a href={`${BASE_URL}blog/`}>← Volver a todos los artículos</a></p>
</BaseLayout>

<style>
	.tag-header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}
	.eyebrow {
		margin: 0 0 0.35rem;
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.tag-header h1 {
		margin: 0 0 0.5rem;
	}
	.tag-header h1 span {
		color: var(--accent-dark);
	}
	.count {
		margin: 0;
		color: rgb(var(--gray));
	}
	.all-tags {
		margin: 0 0 2rem;
		padding: 1rem 1.25rem;
		background: rgba(96, 165, 250, 0.06);
		border: 1px solid var(--border);
		border-radius: 14px;
	}
	.all-tags h2 {
		margin: 0 0 0.75rem;
		font-size: 1.05rem;
	}
	.back {
		margin-top: 2rem;
	}
</style>
