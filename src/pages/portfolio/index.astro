---
import ProjectList from '../../components/ProjectList.astro';
import { BASE_URL } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { BreadcrumbItem } from '../../utils/jsonld';
import { getSortedProjects } from '../../utils/portfolio';

const projects = await getSortedProjects();
const breadcrumbs: BreadcrumbItem[] = [
	{ name: 'Inicio', url: BASE_URL },
	{ name: 'Portafolio' },
];
---

<BaseLayout
	title="Portafolio"
	description="Proyectos de GitHub y fichas propias: aplicaciones, sitios web y herramientas, con enlaces al código y a la versión publicada."
	mainClass="wide"
	{breadcrumbs}
>
	<h1>Portafolio</h1>
	<p>
		Estos son mis repositorios públicos de GitHub y mis proyectos documentados. Los datos y la
		imagen de cada repo se obtienen al compilar el sitio; las fichas propias añaden detalles como
		el rol o la fecha de realización.
	</p>
	{projects.length > 0 ? (
		<ProjectList {projects} />
	) : (
		<p>No hay proyectos publicados todavía.</p>
	)}
</BaseLayout>
