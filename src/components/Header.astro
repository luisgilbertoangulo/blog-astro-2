---
import { BASE_URL, SITE_TITLE } from '../consts';
import GitHubIcon from './GitHubIcon.astro';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="brand-title">
			<a href={BASE_URL} class="brand">
				<img src={`${BASE_URL}logo.svg`} alt="" width="28" height="28" />
				{SITE_TITLE}
			</a>
		</div>
		<div class="internal-links">
			<HeaderLink href={BASE_URL}>Inicio</HeaderLink>
			<HeaderLink href={`${BASE_URL}blog/`}>Blog</HeaderLink>
			<HeaderLink href={`${BASE_URL}portfolio/`}>Portafolio</HeaderLink>
			<HeaderLink href={`${BASE_URL}cv/`}>Currículum</HeaderLink>
			<HeaderLink href={`${BASE_URL}about/`}>Sobre mí</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://github.com/luisgilbertoangulo" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Perfil de GitHub de Luis</span>
				<GitHubIcon />
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 clamp(1em, 4vw, 2.5em);
		background: rgba(15, 23, 42, 0.78);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--border);
	}
	.brand-title {
		margin: 0;
		font-size: 1.05em;
	}

	.brand-title a,
	.brand-title a.active {
		text-decoration: none;
		font-family: var(--font-manrope), var(--font-inter), sans-serif;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: rgb(var(--black));
	}
	.brand-title a.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.brand-title img {
		width: 28px;
		height: 28px;
		border-radius: 0;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin: 0 auto;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	nav a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	.internal-links a {
		padding: 0.55em 1.1em;
		border-radius: 999px;
		font-weight: 600;
		line-height: 1.4;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.internal-links a:hover,
	.internal-links a:focus-visible {
		background: var(--accent);
		color: #0b1220;
		transform: translateY(-2px);
		box-shadow: 0 8px 18px rgba(96, 165, 250, 0.35);
	}
	.internal-links a.active {
		background: rgba(96, 165, 250, 0.16);
		color: var(--accent-dark);
	}
	.internal-links a.active:hover,
	.internal-links a.active:focus-visible {
		color: #0b1220;
	}
	@media (prefers-reduced-motion: reduce) {
		.internal-links a:hover,
		.internal-links a:focus-visible {
			transform: none;
		}
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
	@media (max-width: 560px) {
		header {
			padding: 0 1em;
		}
		nav {
			flex-wrap: wrap;
			justify-content: center;
			row-gap: 0.35rem;
			padding: 0.5rem 0;
		}
		.brand-title {
			width: 100%;
			text-align: center;
		}
		.brand-title a.brand {
			justify-content: center;
		}
		.internal-links {
			width: 100%;
			justify-content: center;
		}
		.internal-links a {
			padding: 0.45em 0.85em;
			font-size: 0.95em;
		}
	}
</style>
