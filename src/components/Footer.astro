---
import { AUTHOR, BASE_URL } from '../consts';
import GitHubIcon from './GitHubIcon.astro';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {AUTHOR}. Todos los derechos reservados.
	<div class="social-links">
		<a href="https://github.com/luisgilbertoangulo" target="_blank" rel="noopener noreferrer">
			<span class="sr-only">Perfil de GitHub de Luis</span>
			<GitHubIcon />
		</a>
		<a href={`${BASE_URL}rss.xml`}>
			<span class="sr-only">Suscribirse al feed RSS</span>
			RSS
		</a>
	</div>
</footer>
<style>
	footer {
		padding: 2.5em 1em 3em;
		background: transparent;
		border-top: 1px solid var(--border);
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.95em;
	}
	.social-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: var(--accent);
	}
	.social-links a:hover {
		color: var(--accent-dark);
	}
</style>
