---
// Importamos global.css aquí para que se incluya en todas las páginas
// a través del componente <BaseHead />.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { AUTHOR, BASE_URL, SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	imageAlt?: string;
	noindex?: boolean;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
}

const {
	title,
	description,
	image = FallbackImage,
	imageAlt,
	noindex = false,
	type = 'website',
	publishedTime,
	modifiedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = new URL(BASE_URL, Astro.site);
const ogImageURL = new URL(image.src, Astro.url);

const author = {
	'@type': 'Person',
	name: AUTHOR,
	url: 'https://github.com/luisgilbertoangulo',
};

// Datos estructurados: WebSite en páginas normales, BlogPosting en artículos.
const structuredData =
	type === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				image: ogImageURL.href,
				datePublished: publishedTime?.toISOString(),
				dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
				author,
				publisher: { '@type': 'Person', name: SITE_TITLE },
				mainEntityOfPage: canonicalURL.href,
				inLanguage: 'es',
			}
		: {
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: SITE_TITLE,
				url: siteURL.href,
				description,
				publisher: author,
				inLanguage: 'es',
			};
const jsonLd = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!-- Metadatos globales -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0b1220" />
<link rel="icon" type="image/svg+xml" href={`${BASE_URL}favicon.svg`} />
<link rel="icon" href={`${BASE_URL}favicon.ico`} />
<link rel="sitemap" href={`${BASE_URL}sitemap-index.xml`} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL(`${BASE_URL}rss.xml`, Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-manrope" preload />

<!-- URL canónica -->
{!noindex && <link rel="canonical" href={canonicalURL} />}

<!-- Etiquetas principales -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:alt" content={imageAlt ?? description} />
<meta property="og:locale" content="es_ES" />
{type === 'article' && publishedTime && (
	<meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && modifiedTime && (
	<meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{type === 'article' && <meta property="article:author" content={AUTHOR} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={imageAlt ?? description} />

<!-- Datos estructurados -->
{!noindex && <script type="application/ld+json" set:html={jsonLd} />}
