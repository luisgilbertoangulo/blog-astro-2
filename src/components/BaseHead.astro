---
// Importamos global.css aquí para que se incluya en todas las páginas
// a través del componente <BaseHead />.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { AUTHOR, BASE_URL, SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';
import {
	blogPostingNode,
	breadcrumbNode,
	personNode,
	profilePageNode,
	serializeJsonLd,
	webPageNode,
	websiteNode,
	type BreadcrumbItem,
	type JsonLdNode,
} from '../utils/jsonld';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	imageAlt?: string;
	noindex?: boolean;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
	minutes?: number;
	breadcrumbs?: BreadcrumbItem[];
	profile?: boolean;
}

const {
	title,
	description,
	image = FallbackImage,
	imageAlt,
	noindex = false,
	type = 'website',
	publishedTime,
	modifiedTime,
	tags = [],
	minutes,
	breadcrumbs,
	profile = false,
} = Astro.props;

// Astro.site está configurado en astro.config.mjs; el fallback evita fallar en otros entornos.
const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, site);
const siteURL = new URL(BASE_URL, site);
const ogImageURL = new URL(image.src, Astro.url);

// Un único grafo conecta Person, WebSite y, según la página, el resto de entidades.
const graph: JsonLdNode[] = [personNode(siteURL), websiteNode(siteURL)];

if (type === 'article') {
	graph.push(
		webPageNode({ site: siteURL, canonicalURL, title, description, imageURL: ogImageURL }),
		blogPostingNode({
			site: siteURL,
			canonicalURL,
			imageURL: ogImageURL,
			title,
			description,
			publishedTime,
			modifiedTime,
			tags,
			minutes,
		}),
		breadcrumbNode(canonicalURL, [
			{ name: 'Inicio', url: BASE_URL },
			{ name: 'Artículos', url: `${BASE_URL}blog/` },
			{ name: title },
		]),
	);
} else if (profile) {
	graph.push(profilePageNode(siteURL, canonicalURL, title));
} else if (breadcrumbs?.length) {
	graph.push(breadcrumbNode(canonicalURL, breadcrumbs));
}

const jsonLd = serializeJsonLd(graph);
---

<!-- Metadatos globales -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0b1220" />
<link rel="icon" type="image/svg+xml" href={`${BASE_URL}favicon.svg`} />
<link rel="icon" href={`${BASE_URL}favicon.ico`} />
<link rel="sitemap" href={`${BASE_URL}sitemap-index.xml`} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL(`${BASE_URL}rss.xml`, Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-manrope" preload />

<!-- URL canónica -->
{!noindex && <link rel="canonical" href={canonicalURL} />}

<!-- Etiquetas principales -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:alt" content={imageAlt ?? description} />
<meta property="og:locale" content="es_ES" />
{type === 'article' && publishedTime && (
	<meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && modifiedTime && (
	<meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{type === 'article' && <meta property="article:author" content={AUTHOR} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={imageAlt ?? description} />

<!-- Datos estructurados -->
{!noindex && <script type="application/ld+json" set:html={jsonLd} />}
<meta name="google-site-verification" content="K7htuSeiCSGTJYMDm4ZcO0waIfa0XGR2yLxUYvgNk8U" />